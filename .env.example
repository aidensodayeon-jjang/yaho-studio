# OPENAI_API_KEY: PRIMARY trend-clustering engine (paid, no daily cap).
# When set, /api/youtube-popular-trends uses OpenAI for cross-video clustering.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# GEMINI_API_KEY: Used by the tour-product / opportunity generation endpoints.
# Specify your Gemini API Key in .env.local (do NOT commit real keys to git)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
